{
  "WhatsApp": {
    "Enabled": false,
    "ApiVersion": "v23.0",
    "SessionExpirationMinutes": 30,
    "OutboundWorkerEnabled": false,
    "OutboundBatchSize": 10,
    "OutboundPollingSeconds": 10,
    "OutboundMaxAttempts": 5,
    "OutboundInitialRetrySeconds": 30,
    "PortalUrl": "https://www.comvy.com.br",
    "Templates": {
      "AdministrationMessage": { "Name": "", "Language": "pt_BR" },
      "InformationRequested": { "Name": "resident_reply_required", "Language": "pt_BR", "BodyParameterName": "" },
      "StatusChanged": { "Name": "request_status_update", "Language": "pt_BR" },
      "Resolved": { "Name": "", "Language": "pt_BR" },
      "Cancelled": { "Name": "", "Language": "pt_BR" },
      "Reopened": { "Name": "", "Language": "pt_BR" },
      "ManagerNewRequest": { "Name": "", "Language": "pt_BR" }
    }
  },
  "RequestDraftAi": {
    "Enabled": false,
    "BaseUrl": "https://api.openai.com/v1/",
    "Model": "gpt-4.1-mini",
    "TimeoutSeconds": 15
  },
  "CondominiumAssistant": {
    "EmbeddingModel": "text-embedding-3-small",
    "EmbeddingBatchSize": 64,
    "TopChunks": 10,
    "RerankCandidates": 30,
    "MaximumEligibleChunks": 10000,
    "SearchQueryCount": 5,
    "MinimumRelevanceScore": 0.2
  },
  "RequestDraftAiAudio": {
    "Enabled": false,
    "BaseUrl": "https://api.openai.com/v1/",
    "Model": "gpt-4o-mini-transcribe",
    "TimeoutSeconds": 30
  },
  "DataProtection": {
    "KeysPath": "data-protection-keys"
  },
  "FileStorage": {
    "RootPath": "storage"
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
    }
  },
  "AllowedHosts": "*"
}
